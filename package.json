{
  "name": "dsh-daily-brief",
  "version": "1.0.0",
  "private": false,
  "type": "module",
  "description": "晨报台：开工一屏简报（24h改动/TODO/台账末行/交接档） Daily brief: one-screen workspace summary to start the day.",
  "license": "MIT",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "translation"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@antinomyhq/forge": "*"
  }
}
